# Preferred (canonical) domain — non-www requests 301 to this host
NEXT_PUBLIC_SITE_URL=https://www.gamblerlive.com

# SMTP for the contact form (/api/contact)
# Hostinger: smtp.hostinger.com, 465, secure=true
# Gmail/Workspace: smtp.gmail.com, 465, secure=true (use an App Password)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@gamblerlive.com
SMTP_PASS=your-smtp-password

# Sender shown on emails (should be the SMTP_USER mailbox or a verified alias)
MAIL_FROM="GamblerLive <contact@gamblerlive.com>"
# Inbox that receives contact form messages
CONTACT_TO=contact@gamblerlive.com
# Send confirmation email to the user (true/false)
CONTACT_AUTOREPLY=true
# true = show exact SMTP error on the form (debugging only, turn off after fixing)
SMTP_DEBUG=false
